---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Sidebar from "../components/Sidebar.astro";
import LessonNavigation from "../components/LessonNavigation.astro";
import "../styles/lesson-blocks.css";

type LessonEntry = CollectionEntry<"lessons">;

interface NavItem {
  title: string;
  href: string;
}

interface Props {
  lesson: LessonEntry;
  courseLessons: LessonEntry[];
  courseTitle: string;
  courseHref: string;
  previous?: NavItem;
  next?: NavItem;
}

const {
  lesson,
  courseLessons,
  courseTitle,
  courseHref,
  previous,
  next,
} = Astro.props;

const levelLabels = {
  inicial: "Inicial",
  basico: "Básico",
  intermedio: "Intermedio",
  "avanzado-secundario": "Avanzado secundario",
};

const cycleLabels = {
  basico: "Ciclo básico",
  orientado: "Ciclo orientado",
  ambos: "Ambos ciclos",
};

const statusLabels = {
  draft: "Borrador",
  review: "En revisión",
  complete: "Completo",
};
---

<BaseLayout
  title={lesson.data.title}
  description={lesson.data.description}
>
  <main class="container lesson-page">
    <Breadcrumbs
      items={[
        { label: "Inicio", href: "/" },
        { label: courseTitle, href: courseHref },
        { label: lesson.data.title },
      ]}
    />

    <div class="lesson-grid">
      <Sidebar
        lessons={courseLessons}
        currentSlug={lesson.data.slug}
        basePath={courseHref}
        courseTitle={courseTitle}
      />

      <article class="lesson-article">
        <header class="lesson-header">
          <div class="lesson-kickers">
            <span class="badge">{lesson.data.module}</span>
            <span class="badge">{levelLabels[lesson.data.level]}</span>
            <span class="badge">{cycleLabels[lesson.data.cycle]}</span>
            <span class="badge">{statusLabels[lesson.data.status]}</span>
          </div>

          <h1>{lesson.data.title}</h1>
          <p>{lesson.data.description}</p>

          {
            lesson.data.yearsApprox.length > 0 && (
              <div class="lesson-meta">
                <span>
                  Años aproximados: {lesson.data.yearsApprox.join(", ")}
                </span>

                {lesson.data.hasExercises && <span>Incluye ejercicios</span>}
                {lesson.data.hasQuiz && <span>Incluye autoevaluación</span>}
                {lesson.data.hasExperiment && <span>Incluye experiencia</span>}
                {lesson.data.deepening && <span>Incluye profundización</span>}
              </div>
            )
          }
        </header>

        <div class="lesson-content">
          <slot />
        </div>

        <LessonNavigation previous={previous} next={next} />
      </article>
    </div>
  </main>
</BaseLayout>

<style>
  .lesson-page {
    padding: 2rem 0 5rem;
  }

  .lesson-grid {
    display: grid;
    grid-template-columns: minmax(230px, 280px) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .lesson-article {
    min-width: 0;
    padding: clamp(1.2rem, 3vw, 2.4rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .lesson-header {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .lesson-kickers,
  .lesson-meta {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .lesson-header h1 {
    max-width: 850px;
    margin: 1rem 0 0;
    font-size: clamp(2.1rem, 5vw, 3.7rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .lesson-header > p {
    max-width: 780px;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .lesson-meta {
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .lesson-meta span {
    padding-right: 0.7rem;
    border-right: 1px solid var(--border);
  }

  .lesson-meta span:last-child {
    border-right: 0;
  }

  .lesson-content {
    max-width: 820px;
    padding-top: 1.5rem;
    color: var(--text);
    font-size: 1.02rem;
    line-height: 1.78;
  }

  .lesson-content :global(h2) {
    margin: 2.6rem 0 0.85rem;
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .lesson-content :global(h3) {
    margin: 2rem 0 0.6rem;
    font-size: 1.25rem;
  }

  .lesson-content :global(p) {
    margin: 0.9rem 0;
  }

  .lesson-content :global(ul),
  .lesson-content :global(ol) {
    padding-left: 1.35rem;
  }

  .lesson-content :global(li) {
    margin: 0.45rem 0;
  }

  .lesson-content :global(blockquote) {
    margin: 1.5rem 0;
    padding: 1rem 1.1rem;
    border-left: 4px solid var(--primary);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--muted);
    background: var(--surface-soft);
  }

  .lesson-content :global(code) {
    padding: 0.12rem 0.35rem;
    border-radius: 6px;
    background: var(--code-bg);
  }

  .lesson-content :global(a) {
    color: var(--primary-strong);
    font-weight: 700;
  }

  .lesson-content :global(hr) {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 960px) {
    .lesson-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
