---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/ruta", label: "Ruta" },
  { href: "/temas", label: "Temas" },
  { href: "/tabla", label: "Tabla" },
];

const isActive = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Ir al inicio">
      <span class="brand-mark" aria-hidden="true">φ</span>
      <span>
        <strong>Física & Físico-Química</strong>
        <small>Curso secundario</small>
      </span>
    </a>

    <nav aria-label="Navegación principal">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid rgba(219, 227, 234, 0.9);
    background: rgba(246, 248, 251, 0.9);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 12px;
    color: white;
    background: linear-gradient(145deg, var(--primary), var(--secondary));
    font-family: Georgia, serif;
    font-size: 1.45rem;
    box-shadow: 0 8px 22px rgba(23, 107, 135, 0.22);
  }

  .brand strong,
  .brand small {
    display: block;
  }

  .brand strong {
    font-size: 0.95rem;
  }

  .brand small {
    margin-top: 0.08rem;
    color: var(--muted);
    font-size: 0.72rem;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    padding: 0.55rem 0.75rem;
    border-radius: 10px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--primary-strong);
    background: rgba(23, 107, 135, 0.08);
  }

  @media (max-width: 650px) {
    .header-inner {
      min-height: auto;
      padding-top: 0.8rem;
      padding-bottom: 0.8rem;
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      width: 100%;
    }

    .nav-link {
      flex: 1;
      text-align: center;
    }
  }
</style>
