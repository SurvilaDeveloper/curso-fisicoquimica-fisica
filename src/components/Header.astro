---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/ruta", label: "Ruta" },
  { href: "/temas", label: "Temas" },
  { href: "/tabla", label: "Tabla" },
];

const isActive = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Ir al inicio">
      <span class="brand-mark" aria-hidden="true">φ</span>
      <span>
        <strong>Física & Físico-Química</strong>
        <small>Curso secundario</small>
      </span>
    </a>

    <div class="header-actions">
      <nav aria-label="Navegación principal">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={["nav-link", { active: isActive(item.href) }]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="Cambiar tema"
        title="Cambiar tema"
      >
        <span class="theme-icon" data-theme-icon aria-hidden="true">◐</span>
        <span class="theme-label" data-theme-label>Tema</span>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const icon = document.querySelector<HTMLElement>("[data-theme-icon]");
  const label = document.querySelector<HTMLElement>("[data-theme-label]");

  const updateThemeButton = () => {
    const current = root.dataset.theme === "dark" ? "dark" : "light";
    const target = current === "dark" ? "claro" : "oscuro";

    if (icon) {
      icon.textContent = current === "dark" ? "☀" : "☾";
    }

    if (label) {
      label.textContent = current === "dark" ? "Claro" : "Oscuro";
    }

    if (button) {
      button.setAttribute("aria-label", `Cambiar a tema ${target}`);
      button.setAttribute("title", `Cambiar a tema ${target}`);
    }
  };

  updateThemeButton();

  button?.addEventListener("click", () => {
    const current = root.dataset.theme === "dark" ? "dark" : "light";
    const next = current === "dark" ? "light" : "dark";

    root.dataset.theme = next;
    localStorage.setItem("theme", next);
    updateThemeButton();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--border);
    background: var(--header-bg);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 12px;
    color: white;
    background: linear-gradient(145deg, var(--primary), var(--secondary));
    font-family: Georgia, serif;
    font-size: 1.45rem;
    box-shadow: 0 8px 22px rgba(23, 107, 135, 0.22);
  }

  .brand strong,
  .brand small {
    display: block;
  }

  .brand strong {
    font-size: 0.95rem;
  }

  .brand small {
    margin-top: 0.08rem;
    color: var(--muted);
    font-size: 0.72rem;
  }

  .header-actions,
  nav {
    display: flex;
    align-items: center;
  }

  .header-actions {
    gap: 0.7rem;
  }

  nav {
    gap: 0.25rem;
  }

  .nav-link {
    padding: 0.55rem 0.75rem;
    border-radius: 10px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--primary-strong);
    background: var(--primary-soft);
  }

  .theme-toggle {
    display: inline-flex;
    min-height: 38px;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    align-items: center;
    gap: 0.45rem;
    color: var(--text);
    background: var(--surface);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--primary);
    background: var(--surface-hover);
  }

  .theme-icon {
    width: 1rem;
    font-size: 1rem;
    text-align: center;
  }

  .theme-label {
    font-size: 0.78rem;
    font-weight: 800;
  }

  @media (max-width: 760px) {
    .header-inner {
      min-height: auto;
      padding-top: 0.8rem;
      padding-bottom: 0.8rem;
      align-items: flex-start;
      flex-direction: column;
    }

    .header-actions {
      width: 100%;
    }

    nav {
      flex: 1;
    }

    .nav-link {
      flex: 1;
      text-align: center;
    }
  }

  @media (max-width: 470px) {
    .theme-label {
      display: none;
    }
  }
</style>
