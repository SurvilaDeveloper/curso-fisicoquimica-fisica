---
import type { CollectionEntry } from "astro:content";
import { withBase } from "../utils/paths";

type LessonEntry = CollectionEntry<"lessons">;

interface Props {
  lessons: LessonEntry[];
  currentSlug: string;
  basePath: string;
  courseTitle: string;
}

const {
  lessons,
  currentSlug,
  basePath,
  courseTitle,
} = Astro.props;

const sortedLessons = [...lessons].sort(
  (a, b) => a.data.order - b.data.order,
);

const currentLesson = sortedLessons.find(
  (lesson) => lesson.data.slug === currentSlug,
);
---

<aside
  class="lesson-sidebar lesson-sidebar--desktop"
  aria-label={`Lecciones de ${courseTitle}`}
>
  <div class="sidebar-heading">
    <span>Contenido del curso</span>
    <strong>{courseTitle}</strong>
  </div>

  <ol>
    {
      sortedLessons.map((lesson, index) => {
        const active = lesson.data.slug === currentSlug;

        return (
          <li>
            <a
              class:list={["lesson-link", { active }]}
              href={withBase(`${basePath}/${lesson.data.slug}`)}
              aria-current={active ? "page" : undefined}
            >
              <span class="lesson-number">
                {String(index + 1).padStart(2, "0")}
              </span>

              <span>{lesson.data.title}</span>
            </a>
          </li>
        );
      })
    }
  </ol>
</aside>

<details
  class="lesson-sidebar-mobile"
  aria-label={`Lecciones de ${courseTitle}`}
>
  <summary>
    <span class="mobile-summary-copy">
      <span>Contenido del curso</span>
      <strong>{currentLesson?.data.title ?? courseTitle}</strong>
    </span>

    <span class="mobile-summary-action" aria-hidden="true">
      Ver temas
    </span>
  </summary>

  <ol>
    {
      sortedLessons.map((lesson, index) => {
        const active = lesson.data.slug === currentSlug;

        return (
          <li>
            <a
              class:list={["lesson-link", { active }]}
              href={withBase(`${basePath}/${lesson.data.slug}`)}
              aria-current={active ? "page" : undefined}
            >
              <span class="lesson-number">
                {String(index + 1).padStart(2, "0")}
              </span>

              <span>{lesson.data.title}</span>
            </a>
          </li>
        );
      })
    }
  </ol>
</details>

<style>
  .lesson-sidebar {
    position: sticky;
    top: 94px;
    width: 100%;
    max-height: calc(100vh - 118px);
    overflow-x: hidden;
    overflow-y: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
  }

  .sidebar-heading {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface-soft);
  }

  .sidebar-heading span,
  .sidebar-heading strong {
    display: block;
  }

  .sidebar-heading span {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .sidebar-heading strong {
    margin-top: 0.25rem;
  }

  ol {
    display: grid;
    margin: 0;
    padding: 0.6rem;
    gap: 0.25rem;
    list-style: none;
  }

  .lesson-link {
    display: grid;
    min-width: 0;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.7rem;
    padding: 0.7rem;
    border-radius: 10px;
    align-items: start;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.35;
    text-decoration: none;
  }

  .lesson-link span:last-child {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .lesson-link:hover {
    color: var(--text);
    background: var(--surface-hover);
  }

  .lesson-link.active {
    color: var(--primary-strong);
    background: var(--primary-soft);
    font-weight: 750;
  }

  .lesson-number {
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 900;
  }

  .lesson-sidebar-mobile {
    display: none;
  }

  @media (max-width: 960px) {
    .lesson-sidebar--desktop {
      display: none;
    }

    .lesson-sidebar-mobile {
      display: block;
      width: 100%;
      margin: 0 0 1rem;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      background: var(--surface);
      box-shadow: var(--shadow-soft);
    }

    .lesson-sidebar-mobile summary {
      display: flex;
      min-width: 0;
      padding: 0.9rem 1rem;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      color: var(--text);
      background: var(--surface-soft);
      cursor: pointer;
      list-style: none;
    }

    .lesson-sidebar-mobile summary::-webkit-details-marker {
      display: none;
    }

    .mobile-summary-copy {
      min-width: 0;
    }

    .mobile-summary-copy > span,
    .mobile-summary-copy > strong {
      display: block;
    }

    .mobile-summary-copy > span {
      color: var(--muted);
      font-size: 0.66rem;
      font-weight: 800;
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }

    .mobile-summary-copy > strong {
      margin-top: 0.2rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .mobile-summary-action {
      flex: 0 0 auto;
      color: var(--primary-strong);
      font-size: 0.78rem;
      font-weight: 800;
    }

    .lesson-sidebar-mobile[open] .mobile-summary-action {
      font-size: 0;
    }

    .lesson-sidebar-mobile[open] .mobile-summary-action::after {
      content: "Ocultar";
      font-size: 0.78rem;
    }

    .lesson-sidebar-mobile ol {
      max-height: min(55vh, 420px);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }

  @media (max-width: 480px) {
    .lesson-sidebar-mobile summary {
      padding: 0.8rem 0.85rem;
    }

    .mobile-summary-action {
      font-size: 0.72rem;
    }

    .lesson-sidebar-mobile[open] .mobile-summary-action::after {
      font-size: 0.72rem;
    }

    .lesson-link {
      padding: 0.68rem;
      gap: 0.55rem;
    }
  }
</style>
