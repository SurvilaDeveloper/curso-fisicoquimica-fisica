---
import {
  getCollection,
  type CollectionEntry,
} from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";

const lessons = await getCollection("lessons");

type LessonEntry = CollectionEntry<"lessons">;

const courseOrder: Record<string, number> = {
  fisicoquimica: 1,
  fisica: 2,
  matematicas: 3,
  aplicaciones: 4,
  experimentos: 5,
};

const courseLabels: Record<string, string> = {
  fisicoquimica: "Físico-Química",
  fisica: "Física",
  matematicas: "Matemáticas para Física",
  aplicaciones: "Aplicaciones",
  experimentos: "Experimentos",
};

const lessonPrefixes: Record<string, string> = {
  fisicoquimica: "FQ",
  fisica: "F",
  matematicas: "M",
  aplicaciones: "A",
  experimentos: "E",
};

const levelLabels: Record<string, string> = {
  inicial: "Inicial",
  basico: "Básico",
  intermedio: "Intermedio",
  "avanzado-secundario": "Avanzado secundario",
};

const statusLabels: Record<string, string> = {
  draft: "Borrador",
  review: "En revisión",
  complete: "Completa",
};

const sortedLessons = [...lessons].sort(
  (a: LessonEntry, b: LessonEntry) => {
    const courseDifference =
      (courseOrder[a.data.course] ?? 99) - (courseOrder[b.data.course] ?? 99);

    if (courseDifference !== 0) {
      return courseDifference;
    }

    return a.data.order - b.data.order;
  },
);

const lessonCode = (lesson: LessonEntry) =>
  `${lessonPrefixes[lesson.data.course] ?? lesson.data.course}-${String(
    lesson.data.order,
  ).padStart(2, "0")}`;

const lessonHref = (lesson: LessonEntry) =>
  withBase(`/${lesson.data.course}/${lesson.data.slug}`);
---

<BaseLayout
  title="Tabla"
  description="Tabla completa de lecciones del curso."
>
  <main class="container page-shell">
    <header class="page-heading">
      <span class="eyebrow">Vista completa</span>
      <h1>Tabla de contenidos</h1>
      <p>
        Vista compacta de las colecciones publicadas. Está ordenada por
        Físico-Química, Física, Matemáticas para Física y Aplicaciones, y permite
        entrar directamente a cualquier lección.
      </p>
    </header>

    <p class="summary">
      Lecciones publicadas: <strong>{sortedLessons.length}</strong>
    </p>

    {
      sortedLessons.length === 0 ? (
        <div class="empty-state">No se detectaron lecciones.</div>
      ) : (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Curso</th>
                <th>Módulo</th>
                <th>Orden</th>
                <th>Título</th>
                <th>Nivel</th>
                <th>Estado</th>
              </tr>
            </thead>

            <tbody>
              {
                sortedLessons.map((lesson: LessonEntry) => (
                  <tr>
                    <td>{courseLabels[lesson.data.course] ?? lesson.data.course}</td>
                    <td>{lesson.data.module}</td>
                    <td>{lessonCode(lesson)}</td>
                    <td>
                      <a class="table-link" href={lessonHref(lesson)}>
                        <strong>{lesson.data.title}</strong>
                      </a>
                    </td>
                    <td>{levelLabels[lesson.data.level] ?? lesson.data.level}</td>
                    <td>{statusLabels[lesson.data.status] ?? lesson.data.status}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      )
    }
  </main>
</BaseLayout>

<style>
  code {
    padding: 0.08rem 0.3rem;
    border-radius: 6px;
    background: var(--surface-soft);
  }

  .summary {
    margin: 0 0 1rem;
    color: var(--muted);
  }

  td strong {
    color: var(--text);
  }

  .table-link {
    color: inherit;
    text-decoration: none;
  }

  .table-link:hover {
    color: var(--primary-strong);
    text-decoration: underline;
  }
</style>
