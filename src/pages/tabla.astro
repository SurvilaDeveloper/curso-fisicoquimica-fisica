---
import {
  getCollection,
  type CollectionEntry,
} from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const lessons = await getCollection("lessons");

type LessonEntry = CollectionEntry<"lessons">;

const sortedLessons = [...lessons].sort(
  (a: LessonEntry, b: LessonEntry) => {
    if (a.data.course !== b.data.course) {
      return a.data.course.localeCompare(b.data.course, "es");
    }

    if (a.data.module !== b.data.module) {
      return a.data.module.localeCompare(b.data.module, "es");
    }

    return a.data.order - b.data.order;
  },
);
---

<BaseLayout
  title="Tabla"
  description="Tabla completa de lecciones del curso."
>
  <main class="container page-shell">
    <header class="page-heading">
      <span class="eyebrow">Vista completa</span>
      <h1>Tabla de contenidos</h1>
      <p>
        Esta página se genera a partir de la colección
        <code>lessons</code>. A medida que agreguemos contenido, la tabla se
        actualizará automáticamente.
      </p>
    </header>

    <p class="summary">
      Lecciones detectadas: <strong>{sortedLessons.length}</strong>
    </p>

    {
      sortedLessons.length === 0 ? (
        <div class="empty-state">No se detectaron lecciones.</div>
      ) : (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Curso</th>
                <th>Módulo</th>
                <th>Orden</th>
                <th>Título</th>
                <th>Nivel</th>
                <th>Estado</th>
              </tr>
            </thead>

            <tbody>
              {
                sortedLessons.map((lesson: LessonEntry) => (
                  <tr>
                    <td>{lesson.data.course}</td>
                    <td>{lesson.data.module}</td>
                    <td>{lesson.data.order}</td>
                    <td><strong>{lesson.data.title}</strong></td>
                    <td>{lesson.data.level}</td>
                    <td>{lesson.data.status}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      )
    }
  </main>
</BaseLayout>

<style>
  code {
    padding: 0.08rem 0.3rem;
    border-radius: 6px;
    background: var(--surface-soft);
  }

  .summary {
    margin: 0 0 1rem;
    color: var(--muted);
  }

  td strong {
    color: var(--text);
  }
</style>
