---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const lessons = (await getCollection("lessons"))
  .filter((lesson) => lesson.data.course === "fisica")
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Física"
  description="Curso completo de Física para nivel secundario."
>
  <main class="container page-shell">
    <header class="page-heading">
      <span class="eyebrow">Curso principal</span>
      <h1>Física</h1>
      <p>
        Desde la descripción del movimiento y las leyes de Newton hasta ondas,
        electromagnetismo, relatividad y física moderna.
      </p>
    </header>

    {
      lessons.length === 0 ? (
        <div class="empty-state">
          La estructura del curso ya está definida, pero todavía no cargamos
          lecciones de Física. Las iremos agregando siguiendo el temario maestro.
        </div>
      ) : (
        <div class="course-list">
          {
            lessons.map((lesson, index) => (
              <a
                class="lesson-row panel"
                href={`/fisica/${lesson.data.slug}`}
              >
                <span class="number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <div>
                  <div class="lesson-topline">
                    <span class="badge">{lesson.data.module}</span>
                    <span class="status">{lesson.data.status}</span>
                  </div>

                  <h2>{lesson.data.title}</h2>
                  <p>{lesson.data.description}</p>
                </div>

                <span class="arrow" aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      )
    }
  </main>
</BaseLayout>

<style>
  .course-list {
    display: grid;
    gap: 0.8rem;
    max-width: 950px;
  }

  .lesson-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    padding: 1.25rem;
    align-items: start;
    color: inherit;
    text-decoration: none;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease;
  }

  .lesson-row:hover {
    transform: translateY(-2px);
    border-color: var(--primary);
    background: var(--surface-hover);
  }

  .number {
    color: var(--primary);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .lesson-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .status {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h2 {
    margin: 0.65rem 0 0;
    font-size: 1.35rem;
  }

  p {
    margin: 0.4rem 0 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .arrow {
    color: var(--primary);
    font-size: 1.35rem;
  }
</style>
