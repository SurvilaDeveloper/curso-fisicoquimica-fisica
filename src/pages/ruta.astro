---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const lessons = await getCollection("lessons");

const tracks = [
  {
    id: "a",
    title: "Base Físico-Química",
    description:
      "Ciencia y medición, materia, partículas, estructura atómica, transformaciones, energía y fenómenos eléctricos.",
    href: "/fisicoquimica",
    count: lessons.filter((lesson) => lesson.data.course === "fisicoquimica")
      .length,
  },
  {
    id: "b",
    title: "Física clásica",
    description:
      "Herramientas matemáticas, cinemática, dinámica, energía, fluidos, termodinámica, ondas, óptica y electromagnetismo.",
    href: "/fisica",
    count: lessons.filter((lesson) => lesson.data.course === "fisica").length,
  },
  {
    id: "c",
    title: "Física moderna",
    description:
      "Crisis de la física clásica, fotones, cuántica introductoria, relatividad, física nuclear e interacciones fundamentales.",
    href: "/fisica",
    count: lessons.filter(
      (lesson) =>
        lesson.data.course === "fisica" &&
        lesson.data.level === "avanzado-secundario",
    ).length,
  },
];
---

<BaseLayout
  title="Ruta"
  description="Ruta didáctica recomendada del curso de Física y Físico-Química."
>
  <main class="container page-shell">
    <header class="page-heading">
      <span class="eyebrow">Recorrido sugerido</span>
      <h1>Ruta de aprendizaje</h1>
      <p>
        Podés consultar cualquier tema por separado, pero esta secuencia intenta
        mantener los prerrequisitos en un orden razonable.
      </p>
    </header>

    <div class="route">
      {
        tracks.map((track, index) => (
          <article class="route-step panel">
            <div class="route-index">{track.id.toUpperCase()}</div>

            <div class="route-copy">
              <span class="badge">
                {track.count} lección{track.count === 1 ? "" : "es"} cargada
                {track.count === 1 ? "" : "s"}
              </span>
              <h2>{track.title}</h2>
              <p>{track.description}</p>
              <a class="text-link" href={track.href}>Explorar este recorrido →</a>
            </div>

            {index < tracks.length - 1 && <span class="route-arrow">↓</span>}
          </article>
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  .route {
    display: grid;
    gap: 1rem;
    max-width: 900px;
  }

  .route-step {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding: 1.5rem;
  }

  .route-index {
    display: grid;
    width: 3.2rem;
    height: 3.2rem;
    place-items: center;
    border-radius: 15px;
    color: white;
    background: linear-gradient(145deg, var(--primary), var(--secondary));
    font-weight: 900;
  }

  .route-copy h2 {
    margin: 0.7rem 0 0;
    font-size: 1.6rem;
    letter-spacing: -0.025em;
  }

  .route-copy p {
    margin: 0.6rem 0 1rem;
    color: var(--muted);
    line-height: 1.7;
  }

  .route-arrow {
    position: absolute;
    left: 2.8rem;
    bottom: -1.45rem;
    z-index: 2;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--primary);
    background: var(--surface);
    font-weight: 900;
  }
</style>
