---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";

const lessons = await getCollection("lessons");

const tracks = [
  {
    id: "a",
    label: "Base recomendada",
    title: "Base Físico-Química",
    description:
      "Ciencia y medición, materia, partículas, estructura atómica, transformaciones, energía, fuerzas, electricidad, magnetismo y ondas.",
    href: "/fisicoquimica",
    count: lessons.filter((lesson) => lesson.data.course === "fisicoquimica")
      .length,
  },
  {
    id: "b",
    label: "Profundización",
    title: "Física clásica",
    description:
      "Herramientas matemáticas, cinemática, dinámica, energía, fluidos, termodinámica, ondas, óptica, electricidad y electromagnetismo.",
    href: "/fisica#clasica",
    count: lessons.filter(
      (lesson) =>
        lesson.data.course === "fisica" &&
        lesson.data.order >= 1 &&
        lesson.data.order <= 25,
    ).length,
  },
  {
    id: "c",
    label: "Extensión",
    title: "Física moderna",
    description:
      "Crisis de la física clásica, fotones, cuántica introductoria, relatividad, física nuclear, partículas e interacciones fundamentales.",
    href: "/fisica#moderna",
    count: lessons.filter(
      (lesson) =>
        lesson.data.course === "fisica" &&
        lesson.data.order >= 26 &&
        lesson.data.order <= 33,
    ).length,
  },
];
---

<BaseLayout
  title="Ruta"
  description="Ruta didáctica recomendada del curso de Física y Físico-Química."
>
  <main class="container page-shell">
    <header class="page-heading">
      <span class="eyebrow">Recorrido sugerido</span>
      <h1>Ruta de aprendizaje</h1>
      <p>
        Esta vista propone una progresión pedagógica. No bloquea contenidos:
        podés entrar directamente a Física o consultar cualquier lección por
        separado y usar sus prerrequisitos como guía.
      </p>
    </header>

    <div class="route-note panel">
      <strong>La Ruta recomienda; los prerrequisitos deciden.</strong>
      <p>
        No hace falta completar toda Físico-Química antes de estudiar Física.
        Algunas lecciones recuperarán contenidos previos concretos cuando sean
        realmente necesarios.
      </p>
    </div>

    <div class="route">
      {
        tracks.map((track, index) => (
          <article class="route-step panel">
            <div class="route-index">{track.id.toUpperCase()}</div>

            <div class="route-copy">
              <div class="route-topline">
                <span class="track-label">{track.label}</span>
                <span class="badge">
                  {track.count} lección{track.count === 1 ? "" : "es"}
                </span>
              </div>

              <h2>{track.title}</h2>
              <p>{track.description}</p>
              <a class="text-link" href={withBase(track.href)}>Explorar este recorrido →</a>
            </div>

            {index < tracks.length - 1 && <span class="route-arrow">↓</span>}
          </article>
        ))
      }
    </div>

    <section class="route-support panel">
      <span class="eyebrow">Acompañan toda la ruta</span>
      <h2>Matemáticas y Aplicaciones son transversales</h2>
      <p>
        Matemáticas para Física funciona como biblioteca de repaso: no hace
        falta recorrer M-01 a M-18 de corrido. Aplicaciones reúne problemas y
        contextos reales que podés consultar en distintos momentos del
        recorrido.
      </p>

      <div class="support-links">
        <a class="text-link" href={withBase("/matematicas")}>
          Abrir Matemáticas para Física →
        </a>
        <a class="text-link" href={withBase("/aplicaciones")}>
          Explorar Aplicaciones →
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .route-note {
    max-width: 900px;
    margin-bottom: 1rem;
    padding: 1rem 1.2rem;
    border-left: 4px solid var(--primary);
  }

  .route-note strong {
    display: block;
  }

  .route-note p {
    margin: 0.35rem 0 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .route {
    display: grid;
    gap: 1rem;
    max-width: 900px;
  }

  .route-step {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1.5rem;
  }

  .route-index {
    display: grid;
    width: 3.2rem;
    height: 3.2rem;
    place-items: center;
    border-radius: 15px;
    color: white;
    background: linear-gradient(145deg, var(--primary), var(--secondary));
    font-weight: 900;
  }

  .route-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .track-label {
    color: var(--primary-strong);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .route-copy h2 {
    margin: 0.7rem 0 0;
    font-size: 1.6rem;
    letter-spacing: -0.025em;
  }

  .route-copy p {
    margin: 0.6rem 0 1rem;
    color: var(--muted);
    line-height: 1.7;
  }

  .route-arrow {
    position: absolute;
    left: 2.8rem;
    bottom: -1.45rem;
    z-index: 2;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--primary);
    background: var(--surface);
    font-weight: 900;
  }

  .route-support {
    max-width: 900px;
    margin-top: 2rem;
    padding: 1.5rem;
  }

  .route-support h2 {
    margin: 0;
    font-size: 1.45rem;
    letter-spacing: -0.025em;
  }

  .route-support p {
    max-width: 760px;
    margin: 0.65rem 0 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .support-links {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 560px) {
    .route-step {
      grid-template-columns: 1fr;
    }

    .route-index {
      width: 2.7rem;
      height: 2.7rem;
    }

    .route-arrow {
      left: 1.9rem;
    }
  }
</style>
