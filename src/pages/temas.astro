---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TopicCard from "../components/TopicCard.astro";

const lessons = await getCollection("lessons");

const counts = {
  fisicoquimica: lessons.filter(
    (lesson) => lesson.data.course === "fisicoquimica",
  ).length,
  fisica: lessons.filter((lesson) => lesson.data.course === "fisica").length,
  matematicas: lessons.filter(
    (lesson) => lesson.data.course === "matematicas",
  ).length,
  experimentos: lessons.filter(
    (lesson) => lesson.data.course === "experimentos",
  ).length,
  aplicaciones: lessons.filter(
    (lesson) => lesson.data.course === "aplicaciones",
  ).length,
};
---

<BaseLayout
  title="Temas"
  description="Exploración de contenidos por áreas del curso."
>
  <main class="container page-shell">
    <header class="page-heading">
      <span class="eyebrow">Navegación temática</span>
      <h1>Explorar por temas</h1>
      <p>
        Esta vista funciona como biblioteca de consulta: organiza por área de
        conocimiento, sin exigir que recorras previamente las demás. La Ruta,
        en cambio, propone un orden de estudio.
      </p>
    </header>

    <div class="topics-note panel">
      <strong>Dos formas de usar el mismo curso</strong>
      <p>
        Si estás estudiando desde cero, la Ruta te orienta. Si necesitás
        encontrar un concepto puntual, Temas te lleva directamente al área
        correspondiente.
      </p>
    </div>

    <section>
      <div class="card-grid">
        <TopicCard
          title="Físico-Química"
          description="Materia, soluciones, estructura atómica, reacciones, calor, fuerzas, electricidad y magnetismo introductorio."
          href="/fisicoquimica"
          meta={`${counts.fisicoquimica} lecciones`}
          tone="chemistry"
        />

        <TopicCard
          title="Física"
          description="Física clásica y moderna: mecánica, termodinámica, ondas, óptica, electricidad, magnetismo, relatividad, cuántica y núcleo."
          href="/fisica"
          meta={`${counts.fisica} lecciones`}
          tone="physics"
        />

        <TopicCard
          title="Matemáticas para Física"
          description="Repasos independientes y puntuales de proporcionalidad, álgebra, funciones, trigonometría, gráficos y vectores."
          href="/matematicas"
          meta={`${counts.matematicas} lecciones de apoyo`}
          tone="support"
        />
      </div>
    </section>

    <section class="section" id="matematicas">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Apoyo transversal</span>
          <h2>Matemáticas para Física</h2>
          <p>
            F-01 presenta las herramientas matemáticas dentro del recorrido de
            Física. Esta colección es distinta: reúne los repasos M-01 a M-18
            para consultar solamente la herramienta que haga falta en cada
            momento.
          </p>
        </div>
      </div>

      <div class="support-grid">
        <div class="support panel">
          <div>
            <strong>Matemáticas</strong>
            <small>Biblioteca de repaso independiente</small>
          </div>
          <span>{counts.matematicas} cargadas</span>
        </div>

        <div class="support panel">
          <div>
            <strong>Experimentos</strong>
            <small>Prácticas y demostraciones transversales</small>
          </div>
          <span>{counts.experimentos} cargados</span>
        </div>

        <div class="support panel">
          <div>
            <strong>Aplicaciones</strong>
            <small>Casos tecnológicos y cotidianos</small>
          </div>
          <span>{counts.aplicaciones} cargadas</span>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .topics-note {
    margin-bottom: 1.5rem;
    padding: 1rem 1.2rem;
    border-left: 4px solid var(--secondary);
  }

  .topics-note strong {
    display: block;
  }

  .topics-note p {
    margin: 0.35rem 0 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .support-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .support {
    display: flex;
    padding: 1rem 1.2rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .support div {
    min-width: 0;
  }

  .support strong,
  .support small {
    display: block;
  }

  .support small {
    margin-top: 0.25rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .support > span {
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 0.85rem;
  }

  @media (max-width: 760px) {
    .support-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .support {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
